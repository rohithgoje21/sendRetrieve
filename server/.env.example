MONGODB_URI=mongodb://127.0.0.1:27017/sendretrieve
PORT=8080
# Signs download links and login sessions. Set a long random value in production
# so links and sessions survive restarts.
TOKEN_SECRET=change-me
# Public URL of the site, used in password reset emails and share links.
# Required in production, e.g. https://sendretrieve.up.railway.app
APP_URL=http://localhost:8080
# Number of reverse proxies in front of the app (Railway: 1, none locally: 0)
TRUST_PROXY=1
MAX_FILE_SIZE_MB=50
# UPLOAD_DIR=./uploads

# Email (password reset). Without RESEND_API_KEY, emails are printed to the console.
# RESEND_API_KEY=re_...
# EMAIL_FROM=sendRetrieve <noreply@yourdomain.com>

# Optional. Shares rate limits and lockouts between instances and keeps them
# across restarts. Without it they're kept in memory.
# REDIS_URL=redis://localhost:6379

# Logging: trace, debug, info (default), warn, error, fatal, silent.
# Logs are JSON; in a terminal they're pretty-printed (set LOG_FORMAT=json to keep JSON).
# LOG_LEVEL=info
