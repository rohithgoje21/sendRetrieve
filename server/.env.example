MONGODB_URI=mongodb://127.0.0.1:27017/sendretrieve
PORT=8080
# Signs download links and login sessions. Set a long random value in production
# so links and sessions survive restarts.
TOKEN_SECRET=change-me
# Public URL of the site (the frontend's URL if it's hosted separately), used in
# emails and share links. Required in production, e.g. https://sendretrieve.vercel.app
APP_URL=http://localhost:5173
# Other frontend origins allowed to connect, comma-separated (optional).
# CORS_ORIGINS=https://sendretrieve-git-preview.vercel.app
# Number of reverse proxies in front of the app (Render behind Vercel: 2,
# Railway or Render alone: 1, none locally: 0)
TRUST_PROXY=0

# ---- File storage ----
# "s3" for MinIO, Cloudflare R2, AWS S3 or any S3-compatible service; "disk"
# keeps files in UPLOAD_DIR (fine for trying things out; files are lost
# whenever the server's disk is wiped). Defaults to s3 when S3_BUCKET is set.
#
# Local MinIO (docker compose up -d minio):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=sendretrieve
# S3_ACCESS_KEY_ID=sendretrieve
# S3_SECRET_ACCESS_KEY=sendretrieve-dev-secret
# S3_CREATE_BUCKET=true
#
# Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
#
# S3_PUBLIC_ENDPOINT: the storage address browsers use, if it differs from
# S3_ENDPOINT (e.g. the server reaches MinIO by a Docker service name).
# MAX_FILE_SIZE_MB defaults to 500 with S3 and 50 with disk storage.
# Files bigger than UPLOAD_PART_SIZE_MB (default 8, at least 5 with S3) are
# uploaded in parts: resumable, with each part retried on its own.
# Incomplete multipart uploads take up space until aborted; on AWS/R2 buckets
# the app didn't create, add a lifecycle rule to abort them after a day or two.
# UPLOAD_DIR=./uploads

# Email (password reset, verification codes). Without RESEND_API_KEY, emails
# are written to the log.
# RESEND_API_KEY=re_...
# EMAIL_FROM=sendRetrieve <noreply@yourdomain.com>

# ---- Notifications ----
# In-app and email notifications work out of the box. Browser notifications
# (Web Push) need a key pair: npm run vapid-keys -w server
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# How push services can contact whoever runs the site (mailto: or https: URL).
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# Optional. Rate limits, lockouts and verification codes in Redis (shared
# between instances, kept across restarts), and live updates relayed between
# instances. Without it everything is kept in memory.
# REDIS_URL=redis://localhost:6379

# ---- Background jobs ----
# Optional. With RabbitMQ, jobs (malware scans, file cleanup, emails) go
# through durable queues and run in a separate worker process (npm run worker);
# without it they run inside the API on an in-memory queue.
# AMQP_URL=amqp://sendretrieve:sendretrieve-dev-secret@localhost:5672
# Run the workers inside the API anyway (default: only without AMQP_URL).
# RUN_WORKERS=false
# Delays before retrying a failed job; after the last, it's dead-lettered.
# QUEUE_RETRY_DELAYS_MS=1000,5000,30000

# ---- File safety ----
# Refuse executable files (detected from their contents). Default: true.
# Programs and scripts are also refused by extension (.exe, .bat, .ps1...).
# BLOCK_EXECUTABLES=true
#
# Optional malware scanning with ClamAV (docker compose runs one; see
# test/clamav.test.js to run one on its own). New file shares stay
# "processing" until every file has been scanned clean; a share with an
# infected file is removed. Without CLAMAV_HOST, files aren't scanned.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=300000

# Logging: trace, debug, info (default), warn, error, fatal, silent.
# Logs are JSON; in a terminal they're pretty-printed (set LOG_FORMAT=json to keep JSON).
# LOG_LEVEL=info
