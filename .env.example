MONGODB_URI=mongodb://127.0.0.1:27017/sendretrieve
PORT=8080
# Signs download links. Set a long random value in production so links survive restarts.
TOKEN_SECRET=change-me
# Number of reverse proxies in front of the app (Railway: 1, none locally: 0)
TRUST_PROXY=1
MAX_FILE_SIZE_MB=50
# UPLOAD_DIR=./uploads
